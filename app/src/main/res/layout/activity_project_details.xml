<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.volunteer.VolunteerFragment"
    android:background="@drawable/gradient_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/blue_background"
        android:padding="20dp"
        android:gravity="center">

        <TextView
            android:id="@+id/judulText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Explore Our Project"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="20sp"/>

        <TextView
            android:id="@+id/dateTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="date, time"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="15dp"/>

        <TextView
            android:id="@+id/priceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FREE"
            android:textSize="8sp"
            android:textColor="@color/greenText"
            android:background="@drawable/rounded_corners"
            android:backgroundTint="@color/greenCoupon"
            android:paddingVertical="3dp"
            android:paddingHorizontal="7dp"
            android:gravity="center"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/projectImage"
        android:layout_width="357dp"
        android:layout_height="200dp" 
        android:src="@drawable/milah_plastik"
        android:scaleType="centerCrop"
        android:clipToOutline="true"
        android:background="@drawable/image_project_details_rounded_corners"
        android:layout_margin="20dp"
        android:layout_gravity="center"/>
    
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Organizer"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="30dp"/>

    
</LinearLayout>
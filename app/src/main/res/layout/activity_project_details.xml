<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:android="http://schemas.android.com/apk/res/android" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/main"
        tools:context=".ui.volunteer.VolunteerFragment"
        android:background="@drawable/gradient_background"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/blue_background"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:id="@+id/judulText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Explore Our Event"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <TextView
                android:id="@+id/dateTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="date, time"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="15dp"/>

            <TextView
                android:id="@+id/priceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FREE"
                android:textSize="8sp"
                android:textColor="@color/greenText"
                android:background="@drawable/rounded_corners"
                android:backgroundTint="@color/greenCoupon"
                android:paddingVertical="3dp"
                android:paddingHorizontal="7dp"
                android:gravity="center"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/projectImage"
            android:layout_width="357dp"
            android:layout_height="200dp"
            android:src="@drawable/milah_plastik"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/image_project_details_rounded_corners"
            android:layout_margin="20dp"
            android:layout_gravity="center"/>

        <!--    ORGANIZER -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Organizer"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginHorizontal="30dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginVertical="10dp"
            android:layout_marginHorizontal="30dp">

            <ImageView
                android:id="@+id/logoImage"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/ecominds_foundation"
                android:background="@drawable/rounded_corners"
                android:clipToOutline="true"/>

            <LinearLayout
                android:layout_width="269dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/organizerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organizer Name"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/organizerDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organizer Desc"/>

            </LinearLayout>

        </LinearLayout>

        <!--  ABOUT  -->

        <TextView
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="10dp"
            android:text="About"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/aboutText"
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="5dp"
            android:text="about the event"/>

        <!--  LOCATION  -->

        <TextView
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="10dp"
            android:text="Location"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/locationText"
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="5dp"
            android:text="location of the event"/>

        <!--    MAP-->

        <!--  ABOUT  -->

        <TextView
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="10dp"
            android:text="Reward"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/rounded_corners"
            android:layout_marginHorizontal="30dp"
            android:padding="15dp"
            android:backgroundTint="@color/yellowCoupon">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/volunteer_point_logo"/>

            <TextView
                android:id="@+id/rewardText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:text="20 Volunteer Points"
                android:textColor="@color/yellowText"/>

        </LinearLayout>

<!--        PARTICIPANT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Participants Joined"
            android:textStyle="bold"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="10dp"
            android:textSize="20sp"/>

        <LinearLayout
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:orientation="horizontal"
            android:clipToPadding="true"
            android:padding="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available slot: "
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/slotText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 slots left"
                android:textColor="@color/blue"
                android:textStyle="bold"
                android:layout_gravity="end|right"/>

        </LinearLayout>

        <Button
            android:id="@+id/participateButton"
            android:layout_width="349dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:layout_marginVertical="20dp"
            android:text="Participate to This Event"/>
    </LinearLayout>

</ScrollView>
